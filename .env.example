# Configuración de Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TOKEN=

# Canal de alertas por defecto: Telegram (Bot API).
# Crear un bot con @BotFather para obtener el token, y obtener el chat_id
# (p. ej. enviando un mensaje al bot y consultando getUpdates).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Configuración de Opsgenie (legado; en fin de vida, ver config/alerting.yaml)
OPSGENIE_API_KEY=your_api_key_here

# Configuración de Grafana  
GRAFANA_URL=http://localhost:3000

# Python path (usado por docker-compose)
PYTHONPATH=/app/src
